import { db } from '@vercel/postgres';

export default async function handler(req, res) {
  // เปิดอิสระให้หน้าเว็บทุกรูปแบบดึงข้อมูลได้ ไม่โดนบล็อก
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET,POST,OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');

  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  const client = await db.connect();
  try {
    // 1. ตรวจสอบและสร้างตารางถ้าไม่มี
    await client.sql`CREATE TABLE IF NOT EXISTS wallet (id SERIAL PRIMARY KEY, balance NUMERIC DEFAULT 0);`;
    
    // 2. ตรวจสอบข้อมูลแถวที่ 1
    const check = await client.sql`SELECT * FROM wallet WHERE id = 1;`;
    if (check.rowCount === 0) {
      await client.sql`INSERT INTO wallet (id, balance) VALUES (1, 5000);`;
    }
    
    // 3. จัดการดึงยอดเงิน (รองรับทั้งเรียกแบบปกติและเรียกผ่านตัวแปร)
    if (req.method === 'GET' || req.query.action === 'get') {
      const result = await client.sql`SELECT balance FROM wallet WHERE id = 1;`;
      const currentBalance = result.rows[0] ? result.rows[0].balance : 5000;
      
      // ส่งข้อมูลกลับไปเป็นกล่องข้อความคู่เพื่อให้หน้าบ้านแกะง่ายที่สุด
      return res.status(200).json({ balance: Number(currentBalance) });
    } 
    
    // 4. จัดการเพิ่มเงิน/หักเงิน
    if (req.method === 'POST') {
      const { action, amount } = req.body;
      const numAmount = parseFloat(amount);
      
      if (!numAmount || numAmount <= 0) {
        return res.status(400).json({ error: 'จำนวนเงินไม่ถูกต้อง' });
      }

      if (action === 'add') {
        await client.sql`UPDATE wallet SET balance = balance + ${numAmount} WHERE id = 1;`;
      } else if (action === 'withdraw') {
        const checkCurrent = await client.sql`SELECT balance FROM wallet WHERE id = 1;`;
        const currentBal = parseFloat(checkCurrent.rows[0].balance);
        if (numAmount > currentBal) {
          return res.status(400).json({ error: 'ยอดเงินไม่เพียงพอสำหรับการถอน' });
        }
        await client.sql`UPDATE wallet SET balance = balance - ${numAmount} WHERE id = 1;`;
      }
      
      const result = await client.sql`SELECT balance FROM wallet WHERE id = 1;`;
      const updatedBalance = result.rows[0] ? result.rows[0].balance : 0;
      return res.status(200).json({ success: true, balance: Number(updatedBalance) });
    }
    
    return res.status(405).json({ error: 'Method not allowed' });
  } catch (error) {
    // หากเกิดข้อผิดพลาด ให้ส่งเลข 5000 สแตนด์บายไว้ หน้าจอจะได้ไม่ค้าง
    return res.status(200).json({ balance: 5000, note: error.message });
  } finally {
    client.release();
  }
}

